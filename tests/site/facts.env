# The runtime facts manifests/devcontainer reads as Flux variables, with the
# values the tests and kind use. This file is the contract with the Gitops
# repository, whose bootstrap writes each of them into flux-runtime-info on
# the Management Cluster: tests/repo.py fails if a manifest uses a variable
# not listed here, and docs/check.sh if the README doesn't name one.
#
# NAME=value. *_B64 values are not listed: tests/site/subst.py computes
# DEVCONTAINER_SITE_ENV_B64 and DEVCONTAINER_SITE_CA_B64 from site.env and
# site-ca.crt beside this file.
HARBOR_REGISTRY=harbor.example
HARBOR_PROJECT=platform
DEVCONTAINER_GATEWAY_ADDRESS=
DEVCONTAINER_POD_CIDR=192.168.0.0/16
DEVCONTAINER_SITE_ENV_B64=
DEVCONTAINER_SITE_CA_B64=
