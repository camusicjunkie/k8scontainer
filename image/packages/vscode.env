# The one pin for VS Code: the Standard Image bakes this commit's server (and the
# extensions in vscode-extensions.txt), and the Workstation installer must fetch
# the portable VS Code for this same commit, or Remote-SSH refuses the mismatch
# and downloads a server. VSCODE_REMOTE_SSH_VERSION is the Remote-SSH the
# Workstation pack carries, the newest stable one this VS Code accepts. Plain
# KEY=VALUE so bash can `source` it and PowerShell can parse it. It moves only
# with a Release; release/update-pins.py refreshes it.
VSCODE_VERSION=1.147.0
VSCODE_COMMIT=8a14f0cc1b08d531eb83255ea3764ae22aa932b5
VSCODE_SERVER_SHA256=c6884d30ae036ff4b7e6ecaa23b59a4b9affa32042e018cf61fca728e537667c
VSCODE_CLI_SHA256=b0539f8478426219c05a20dc5fc8e1472b3f4970cb348b6e753a99a6b00248fa
VSCODE_WIN_SHA256=42d65f18009959964d7cff8ca6f33149a195d52c08622821c8c681a08469c26e
VSCODE_REMOTE_SSH_VERSION=0.128.0
