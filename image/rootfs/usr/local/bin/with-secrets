#!/usr/bin/env bash
# with-secrets [-k NAME]... CMD [ARGS...]
#
# Runs CMD with the Secrets File's values in its environment, and nowhere else:
# not in this shell, not on disk, not in any process's arguments. With -k, only
# the named keys. Needs the forwarded agent, so it works in VS Code terminals
# but not in docker exec shells.
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
# shellcheck source=../lib/devc/secrets.bash
source "$here/../lib/devc/secrets.bash"

keys=()
while (($#)); do
    case $1 in
        -k) (($# >= 2)) || die "-k needs a NAME"; keys+=("$2"); shift 2 ;;
        --) shift; break ;;
        -h | --help) sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 0 ;;
        *) break ;;
    esac
done
(($#)) || die "usage: with-secrets [-k NAME]... CMD [ARGS...]"

require_agent
require_secrets_file

# The decrypted file arrives on fd 3, so CMD keeps this shell's stdin.
# Python parses it and execs CMD with the secrets added to its environment.
# The venv's Python has PyYAML (an ansible-core dependency).
python=/opt/venv/bin/python3
# The image always has the venv; the fallback is for tests/Dockerfile, which
# runs this script with a system python3 and no /opt/venv.
[[ -x $python ]] || python=python3
exec "$python" -c '
import os, sys, yaml
path, n = sys.argv[1], int(sys.argv[2])
keys, argv = sys.argv[3:3 + n], sys.argv[3 + n:]
with open(path) as f:
    data = yaml.safe_load(f) or {}
os.close(3)
if not isinstance(data, dict):
    sys.exit("with-secrets: the Secrets File must be NAME: value pairs")
missing = [k for k in keys if k not in data]
if missing:
    sys.exit("with-secrets: not in the Secrets File: " + ", ".join(missing))
env = dict(os.environ)
for k, v in data.items():
    if not keys or k in keys:
        env[str(k)] = "" if v is None else str(v)
try:
    os.execvpe(argv[0], argv, env)
except FileNotFoundError:
    sys.exit("with-secrets: " + argv[0] + ": command not found")
' /dev/fd/3 "${#keys[@]}" "${keys[@]}" "$@" \
    3< <(ansible-vault view --vault-password-file "$here/devc-vault-pass" "$DEVC_SECRETS_FILE")
