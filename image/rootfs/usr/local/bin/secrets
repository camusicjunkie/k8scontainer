#!/usr/bin/env bash
# secrets init|edit|view: the admin's Secrets File, unlocked by the smartcard
# key in the forwarded agent (ADR 0002). The file is at DEVC_SECRETS_FILE
# (default ~/.secrets/vault, i.e. ~/.devc/secrets/vault on the Docker Host).
#
#   secrets init   create it; refuses an existing file, a key that isn't RSA,
#                  and a key whose signatures of the challenge differ
#   secrets edit   change it in $EDITOR
#   secrets view   print it
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
# shellcheck source=../lib/devc/secrets.bash
source "$here/../lib/devc/secrets.bash"
vault() { local action=$1; shift; ansible-vault "$action" --vault-password-file "$here/devc-vault-pass" "$@"; }

template() {
    cat <<'EOF'
# Secrets File: NAME: value pairs. with-secrets puts them in one command's
# environment; playbooks can read the file as vars_files.
VSPHERE_USER: ""
VSPHERE_PASSWORD: ""
GITLAB_TOKEN: ""
AI_GATEWAY_KEY: ""
SOPS_AGE_KEY: ""
EOF
}

cmd_init() {
    local pub type first second
    [[ ! -e $DEVC_SECRETS_FILE ]] ||
        die "$DEVC_SECRETS_FILE already exists; change it with: secrets edit. (A new card means removing it and running secrets init again.)"
    require_agent
    pub=$(mktemp)
    # shellcheck disable=SC2064
    trap "rm -f '$pub'" EXIT
    type=$(unlock_pubkey "$pub")
    [[ $type == RSA ]] ||
        die "the unlock key $DEVC_UNLOCK_KEY is $type, not RSA. Only RSA signatures repeat exactly, so only an RSA key can reopen the Secrets File. Use your card's PIV Authentication key."
    first=$(unlock_signature "$pub") || die "the agent didn't sign with $DEVC_UNLOCK_KEY"
    second=$(unlock_signature "$pub") || die "the agent didn't sign with $DEVC_UNLOCK_KEY"
    [[ -n $first && $first == "$second" ]] ||
        die "two signatures of the same challenge differ, so this key could never reopen the Secrets File. Use your card's PIV Authentication key (RSA)."

    install -d -m 0700 "$(dirname "$DEVC_SECRETS_FILE")"
    template | vault encrypt --output "$DEVC_SECRETS_FILE" -
    echo "Created $DEVC_SECRETS_FILE, unlocked by $DEVC_UNLOCK_KEY (RSA)."
    echo "It must stay your card's PIV Authentication key: the Digital Signature key asks for the PIN on every unlock."
    echo "Fill it in with: secrets edit"
}

case ${1:-} in
    init) cmd_init ;;
    edit) require_agent; require_secrets_file; vault edit "$DEVC_SECRETS_FILE" ;;
    view) require_agent; require_secrets_file; vault view "$DEVC_SECRETS_FILE" ;;
    *) echo "usage: secrets init|edit|view" >&2; exit 2 ;;
esac
